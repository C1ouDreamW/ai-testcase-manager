# LLM 配置（OpenAI 兼容接口）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash

# 未配置 API Key 时使用 mock 模式（返回示例数据）
LLM_MOCK_MODE=true

# 评测专用 LLM（AI Judge / 召回率判定），留空则复用上面的生成模型配置
EVAL_LLM_API_KEY=
EVAL_LLM_BASE_URL=
EVAL_LLM_MODEL=

# 视觉模型（设计稿解析），需支持 OpenAI-compatible 多模态 image_url 消息
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

# Embedding 模型（知识库检索），不配置则知识库功能不可用
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# Rerank 模型（知识库检索精排，可选），留空则只做混合检索融合排序
# 推荐：硅基流动 https://api.siliconflow.cn/v1 + BAAI/bge-reranker-v2-m3
RERANK_API_KEY=
RERANK_BASE_URL=
RERANK_MODEL=

# 额外允许的自建模型 API 域名，逗号分隔；内置预设服务商无需配置
MODEL_API_EXTRA_HOSTS=

# 登录账号（默认 admin / nini123456）
AUTH_USERNAME=admin
AUTH_PASSWORD=nini123456
AUTH_TOKEN_TTL_HOURS=24
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
ALLOW_REGISTRATION=true
REGISTRATION_MAX_PER_HOUR=5

# 数据库（默认 SQLite，生产可改为 PostgreSQL）
DATABASE_URL=sqlite:///./data/app.db
# 设计稿文件目录（留空时默认 backend/data/design-assets）
DESIGN_ASSET_DIR=

# LangGraph 工作流检查点（可选，默认 backend/data/langgraph_checkpoints.sqlite）
AITC_LANGGRAPH_CHECKPOINT_PATH=

# 后端
BACKEND_PORT=8000
DEBUG=true

# 前端跨域
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
